/ {
	aliases {
		dump-mic = &uart0;
		test-i2s = &i2s0;
		test-codec = &codec;
	};
};

&dma0 {
	status = "okay";
};

/* i2s_tx/i2s_rx/i2s_codec_rx */
&i2s0 {
	dmas = <&dma0 0 16 0x2a1>, <&dma0 1 17 0x648a>;
	dma-names = "tx", "rx";
	pinctrl-0 = <&i2s_default>;
	pinctrl-names = "default";
	status = "okay";

	/* internal codec tx/rx, delete if use external codec */
	codec: codec@0 {
		compatible = "realtek,bee-codec";
		reg = <0>;
		channel-sequence = "l_l";
		mic-bias = "1_8";
		mic-bst-gain = "30dB";
		mic-bst-mode = "differential";
		mic-type = "amic"; /* amic */
		/* mic-type = "dmic"; /* dmic */
		dmic-data-latch = "rising_latch";
		ad-gain = <0x2f>;
		boost-gain = "0dB";
		pinctrl-0 = <&codec_default>;
		pinctrl-names = "default";
	};
};

&uart0 {
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
	status = "okay";
	current-speed = <2000000>;
	parity = "none";
	stop-bits = "1";
	data-bits = <8>;
};

&pinctrl {
	i2s_default: i2s_default {
		group1 {
			psels = <BEE_PSEL(LRC_SPORT0, P4_0)>,
				<BEE_PSEL(BCLK_SPORT0, P4_1)>, /* i2s_tx/i2s_codec_rx waveform */
				<BEE_PSEL(DACDAT_SPORT0, P4_2)>; /* i2s_tx/i2s_codec_rx waveform */
			output-enable;
			output-low;
			bias-disable;
		};
	};

	codec_default: codec_default {
		group1 {
			psels = <BEE_PSEL(PWR_OFF, H_0)>, /* amic */
				<BEE_PSEL(PWR_OFF, P2_6)>, /* amic */
				<BEE_PSEL(PWR_OFF, P2_7)>; /* amic */
			/* <BEE_PSEL(DMIC1_CLK, P2_6)>, /* dmic */
			/* <BEE_PSEL(DMIC1_DAT, P2_7)>; /* dmic */
			output-disable;
			bias-disable;
		};
	};

	uart0_default: uart0_default {
		group1 {
			psels = <BEE_PSEL(UART0_TX, P0_0)>;
			output-enable;
			output-high;
			bias-pull-up;
		};
	};
};
