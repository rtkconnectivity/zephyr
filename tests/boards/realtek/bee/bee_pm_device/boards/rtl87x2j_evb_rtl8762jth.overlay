#include <zephyr/dt-bindings/gpio/realtek-bee-gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/input/keymap.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/adc/adc.h>

/* The tests reuse the board key pads, drop the keys with their pins */
/delete-node/ &{/gpio_keys};

/*
 *  P0_0 GPIO(LATCH OUT)
 *  P0_1 TIMER9 LATCH TRIGGER
 *  P0_2 PWM7
 *  P0_4 IR_TX/IR_RX
 *  P0_5 LPPWM
 *  P0_6 KSCAN_R0
 *  P0_7 KSCAN_R1
 *  P1_0 GPIO(TEST LPQDECX)
 *  P1_1 GPIO(TEST LPQDECX)
 *  P1_6 QACTIVE
 *  P1_7 QACTIVE
 *  P2_0 KSCAN_C0
 *  P2_1 PON_PPU
 *  P2_2 ADC
 *  P2_3 I2C0_CLK
 *  P2_4 I2C0_DAT
 *  P2_5 PON_PPU
 *  P2_6 AMIC
 *  P2_7 AMIC
 *  P3_0 UART2_TX
 *  P3_1 UART2_RX
 *  P3_4 LPQDECX_A
 *  P3_5 LPQDECX_B
 *  P3_6 KSCAN_C1
 *  P4_0 PON_PPU
 *  P4_1 PON_PPU
 *  P4_2 PON_PPU
 *  P4_3 GPIO(TEST OUT)
 *  P5_1 UART0_TX(DMA)
 *  P5_2 UART0_RX(DMA)
 *  P6_0 SPI0_CLK
 *  P6_1 SPI0_MO
 *  P6_2 SPI0_MI
 *  P6_3 GPIO(SPI0_CS)
 *  P6_4 GPIO(TEST IN)
 *  P7_0 I2C1_CLK
 *  P7_1 I2C1_DAT
 *  MICBIAS PON_PPU/MICBIAS
 */

/ {
	resources {
		compatible = "test-gpio-basic-api";
		// P4_3
		out-gpios = <&gpioa 30 GPIO_ACTIVE_HIGH>;
		// P6_4
		in-gpios = <&gpiob 6 GPIO_ACTIVE_HIGH>;
	};

	zephyr,user {
		io-channels = <&adc 2>;
		// P0_0
		latch-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
	};

	aliases {
		test-uart-dma = &uart0;
		test-counter-timer = &counter8;
		test-latch-counter = &counter9;
		test-pwm = &pwm7;
		test-lppwm = &lppwm;
		test-rtc = &rtc;
		test-qdec = &qdec;
		test-qenca = &phase_a;
		test-qencb = &phase_b;
		test-i2c = &i2c1;
		test-can = &can;
		test-ir = &ir;
		test-i2s = &i2s0;
		test-codec = &codec;
	};

	encoder-emulate {
		compatible = "gpio-leds";

		phase_a: phase_a {
			// P1_0
			gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;
		};

		phase_b: phase_b {
			// P1_1
			gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>;
		};
	};
};

&uart2 {
	pinctrl-0 = <&uart2_default>;
	pinctrl-names = "default";
	current-speed = <115200>;
	parity = "none";
	stop-bits = "1";
	data-bits = <8>;
	wakeup-source;
	zephyr,pm-device-runtime-auto;
	status = "okay";
};

&uart0 {
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
	current-speed = <2000000>;
	parity = "none";
	stop-bits = "1";
	data-bits = <8>;
	dmas = <&dma0 3 0 0x10021>, <&dma0 2 1 0xa>;
	dma-names = "tx", "rx";
	wakeup-source;
	zephyr,pm-device-runtime-auto;
	status = "disabled";
};

&dma0 {
	status = "okay";
};

&gpioa {
	pinctrl-0 = <&gpioa_default>;
	pinctrl-names = "default";
	status = "okay";
};

&gpiob {
	pinctrl-0 = <&gpiob_default>;
	pinctrl-names = "default";
	status = "okay";
};

&timer8 {
	prescaler = <1>;
	status = "okay";

	counter8: counter {
		compatible = "realtek,bee-counter-timer";
		status = "okay";
	};
};

&timer7 {
	prescaler = <1>;
	status = "okay";

	pwm7: pwm {
		status = "okay";
		pinctrl-0 = <&pwm7_default>;
		pinctrl-names = "default";
	};
};

/* Only TIMER2_CH0 (timer9) has the GPIO latch count */
&timer9 {
	prescaler = <1>;
	status = "okay";

	counter9: counter {
		status = "okay";
		pinctrl-0 = <&latch_default>;
		pinctrl-names = "default";
	};
};

&lppwm {
	status = "okay";
	pinctrl-0 = <&lppwm_default>;
	pinctrl-names = "default";
};

&spi0 {
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
	status = "okay";

	test-spi@0 {
		compatible = "test-spi-loopback";
		reg = <0>;
		spi-max-frequency = <500000>;
	};
};

/* Target of the i2c test, SCL/SDA wired to those of i2c1 */
&i2c0 {
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	eeprom@51 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x51>;
		size = <256>;
	};
};

&i2c1 {
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
};

&rtc_counter {
	prescaler = <1>;
	status = "okay";

	rtc: rtc {
		compatible = "zephyr,rtc-counter";
		alarms-count = <4>;
		status = "okay";
	};
};

&qdec {
	x-enable;
	x-counts-per-revolution = <4>;
	x-debounce-time-ms = <5>;
	pinctrl-0 = <&qdec_default>;
	pinctrl-names = "default";
	status = "okay";
};

&can {
	status = "okay";
};

/* TX and RX share the pad and the DMA channel, the board only sends or
 * receives at a time
 */
&ir {
	pinctrl-0 = <&ir_tx>;
	pinctrl-1 = <&ir_rx>;
	pinctrl-names = "ir-tx", "ir-rx";
	dmas = <&dma0 0 27 0x26a1>, <&dma0 0 28 0x268a>;
	dma-names = "tx", "rx";
	status = "okay";
};

/* Internal codec, records the amic */
&i2s0 {
	dmas = <&dma0 1 17 0x648a>;
	dma-names = "rx";
	status = "okay";

	codec: codec@0 {
		compatible = "realtek,bee-codec";
		reg = <0>;
		clocks = <&cctl APB_CLK(CODEC)>;
		channel-sequence = "l_r";
		mic-bias = "1_8";
		mic-bst-gain = "30dB";
		mic-bst-mode = "differential";
		mic-type = "amic";
		dmic-data-latch = "rising_latch";
		ad-gain = <0x2f>;
		boost-gain = "0dB";
		pinctrl-0 = <&codec_default>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&keyscan {
	pinctrl-0 = <&keyscan_default>;
	pinctrl-names = "default";
	row-size = <2>;
	col-size = <2>;
	scan-div = <15>;
	delay-div = <63>;
	debounce-down-ms = <10>;
	debounce-up-ms = <10>;
	poll-period-us = <50000>;
	release-time-us = <5000>;
	status = "okay";
};

&adc {
	pinctrl-0 = <&adc_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&pinctrl {
	gpioa_default: gpioa_default {
		group1 {
			psels = <BEE_PSEL_GPIOA_0_P0_0>, //P0_0 GPIO(LATCH OUT)
				<BEE_PSEL_GPIOA_30_P4_3>; //P4_3 GPIO(TEST OUT)
		};

		group2 {
			psels = <BEE_PSEL_GPIOA_8_P1_0>, //P1_0 GPIO(TEST LPQDECX)
				<BEE_PSEL_GPIOA_9_P1_1>; //P1_1 GPIO(TEST LPQDECX)
		};
	};

	gpiob_default: gpiob_default {
		group1 {
			psels = <BEE_PSEL_GPIOB_6_P6_4>; //P6_4 GPIO(TEST IN)
		};
	};

	uart2_default: uart2_default {
		group1 {
			psels = <BEE_PSEL(UART2_TX, P3_0)>,
				<BEE_PSEL(UART2_RX, P3_1)>;
			output-disable;
			bias-pull-up;
		};
	};

	uart0_default: uart0_default {
		group1 {
			psels = <BEE_PSEL(UART0_TX, P5_1)>,
				<BEE_PSEL(UART0_RX, P5_2)>;
			output-disable;
			bias-pull-up;
		};
	};

	spi0_default: spi0_default {
		group1 {
			psels = <BEE_PSEL(SPI0_CLK_MASTER, P6_0)>,
				<BEE_PSEL(SPI0_MO_MASTER, P6_1)>,
				<BEE_PSEL(SPI0_MI_MASTER, P6_2)>,
				<BEE_PSEL(SPI0_SS_N_0_MASTER, P6_3)>;
			output-disable;
			bias-pull-up;
		};
	};

	/* Latch trigger pad, driven by latch-gpios */
	latch_default: latch_default {
		group1 {
			psels = <BEE_PSEL(SW_MODE, P0_1)>;
			output-disable;
			bias-disable;
		};
	};

	pwm7_default: pwm7_default {
		group1 {
			psels = <BEE_PSEL(PWM7_P, P0_2)>;
			output-disable;
			bias-disable;
		};
	};

	lppwm_default: lppwm_default {
		group1 {
			psels = <BEE_PSEL(LPPWM_CH0, P0_5)>;
			output-disable;
			bias-disable;
		};
	};

	qdec_default: qdec_default {
		group1 {
			psels = <BEE_PSEL(LPQDEC_PHA, P3_4)>,
				<BEE_PSEL(LPQDEC_PHB, P3_5)>;
			output-disable;
			bias-disable;
		};
	};

	i2c0_default: i2c0_default {
		group1 {
			psels = <BEE_PSEL(I2C0_CLK, P2_3)>,
				<BEE_PSEL(I2C0_DAT, P2_4)>;
			output-disable;
			bias-pull-up;
		};
	};

	i2c1_default: i2c1_default {
		group1 {
			psels = <BEE_PSEL(I2C1_CLK, P7_0)>,
				<BEE_PSEL(I2C1_DAT, P7_1)>;
			output-disable;
			bias-pull-up;
		};
	};

	keyscan_default: keyscan_default {
		group1 {
			psels = <BEE_PSEL(KEY_COL_0, P2_0)>,
				<BEE_PSEL(KEY_COL_1, P3_6)>;
			output-enable;
			output-low;
			bias-disable;
		};

		group2 {
			psels = <BEE_PSEL(KEY_ROW_0, P0_6)>,
				<BEE_PSEL(KEY_ROW_1, P0_7)>;
			output-disable;
			bias-pull-up;
			bias-pull-strong;
		};
	};

	adc_default: adc_default {
		group1 {
			psels = <BEE_PSEL(SW_MODE, P2_2)>;
			output-disable;
			bias-disable;
		};
	};

	ir_tx: ir_tx {
		group1 {
			psels = <BEE_PSEL(IRDA_TX, P0_4)>;
			output-enable;
			output-low;
			bias-disable;
		};
	};

	ir_rx: ir_rx {
		group1 {
			psels = <BEE_PSEL(IRDA_RX, P0_4)>;
			output-disable;
			bias-disable;
		};
	};

	codec_default: codec_default {
		group1 {
			psels = <BEE_PSEL(PWR_OFF, P2_6)>,
				<BEE_PSEL(PWR_OFF, P2_7)>;
			output-disable;
			bias-disable;
		};

		group2 {
			psels = <BEE_PSEL(SW_MODE, MICBIAS)>;
			output-enable;
			output-high;
			bias-disable;
		};
	};
};
