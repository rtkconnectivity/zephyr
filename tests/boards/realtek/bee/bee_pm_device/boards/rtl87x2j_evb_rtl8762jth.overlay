#include <zephyr/dt-bindings/gpio/realtek-bee-gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/input/keymap.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/adc/adc.h>

/*
 *  P0_0
 *  P0_1
 *  P0_2 PWM9
 *  P0_4 GPIO(TEST LPQDECX)
 *  P0_5 GPIO(TEST LPQDECX)
 *  P0_6 KSCAN_R0
 *  P0_7 KSCAN_R1
 *  P1_0 SWD
 *  P1_1 SWD
 *  P1_6 QACTIVE
 *  P1_7 QACTIVE
 *  P2_0 KSCAN_C0
 *  P2_1 PON_PPU
 *  P2_2 ADC
 *  P2_3 I2C0_CLK
 *  P2_4 I2C0_DAT
 *  P2_5 PON_PPU
 *  P3_0 MP_DOWNLOAD
 *  P3_1 MP_DOWNLOAD
 *  P3_2 UART2_TX
 *  P3_3 UART2_RX
 *  P3_4 LPQDECX_A
 *  P3_5 LPQDECX_B
 *  P3_6 KSCAN_C1
 *  P4_0 PON_PPU
 *  P4_1 PON_PPU
 *  P4_2 PON_PPU
 *  P4_3 GPIO(TEST OUT)
 *  P5_1 UART0_TX(DMA)
 *  P5_2 UART0_RX(DMA)
 *  P6_0 SPI0_CLK
 *  P6_1 SPI0_MO
 *  P6_2 SPI0_MI
 *  P6_3 GPIO(SPI0_CS)
 *  P6_4 GPIO(TEST IN)
 *  P7_0 CAN_TX
 *  P7_1 CAN_RX
 *  MICBIAS PON_PPU
 */

/ {
	resources {
		compatible = "test-gpio-basic-api";
		// P4_3
		out-gpios = <&gpioa 30 GPIO_ACTIVE_HIGH>;
		// P6_4
		in-gpios = <&gpiob 6 GPIO_ACTIVE_HIGH>;
	};

	zephyr,user {
		io-channels = <&adc 2>;
	};

	aliases {
		test-uart-dma = &uart0;
		test-counter-timer = &counter8;
		test-pwm = &pwm9;
		test-rtc = &rtc;
		test-qdec = &qdec;
		test-qenca = &phase_a;
		test-qencb = &phase_b;
		test-i2c = &i2c0;
	};

	encoder-emulate {
		compatible = "gpio-leds";

		phase_a: phase_a {
			// P0_4
			gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
		};

		phase_b: phase_b {
			// P0_5
			gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
		};
	};
};

&uart2 {
	pinctrl-0 = <&uart2_default>;
	pinctrl-1 = <&uart2_sleep>;
	pinctrl-names = "default", "sleep";
	current-speed = <2000000>;
	parity = "none";
	stop-bits = "1";
	data-bits = <8>;
	status = "okay";
};

&uart0 {
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
	current-speed = <2000000>;
	parity = "none";
	stop-bits = "1";
	data-bits = <8>;
	dmas = <&dma0 3 0 0x10021>, <&dma0 2 1 0xa>;
	dma-names = "tx", "rx";
	status = "disabled";
};

&dma0 {
	status = "disabled";
};

&gpioa {
	pinctrl-0 = <&gpioa_default>;
	pinctrl-names = "default";
	status = "okay";
};

&gpiob {
	pinctrl-0 = <&gpiob_default>;
	pinctrl-names = "default";
	status = "okay";
};

&timer8 {
	prescaler = <1>;
	status = "okay";

	counter8: counter {
		compatible = "realtek,bee-counter-timer";
		status = "okay";
	};
};

&timer9 {
	prescaler = <1>;
	status = "okay";

	pwm9: pwm {
		status = "okay";
		pinctrl-0 = <&pwm9_default>;
		pinctrl-names = "default";
	};
};

&spi0 {
	pinctrl-0 = <&spi0_default>;
	pinctrl-1 = <&spi0_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";

	test-spi@0 {
		compatible = "test-spi-loopback";
		reg = <0>;
		spi-max-frequency = <500000>;
	};
};

&i2c0 {
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
};

&rtc_counter {
	prescaler = <1>;
	status = "okay";

	rtc: rtc {
		compatible = "zephyr,rtc-counter";
		alarms-count = <4>;
		status = "okay";
	};
};

&qdec {
	x-enable;
	x-counts-per-revolution = <4>;
	x-debounce-time-ms = <5>;
	pinctrl-0 = <&qdec_default>;
	pinctrl-names = "default";
	status = "okay";
};

&keyscan {
	pinctrl-0 = <&keyscan_default>;
	pinctrl-names = "default";
	row-size = <2>;
	col-size = <2>;
	scan-div = <15>;
	delay-div = <63>;
	debounce-down-ms = <10>;
	debounce-up-ms = <10>;
	poll-period-us = <50000>;
	release-time-us = <5000>;
	status = "okay";
};

&adc {
	pinctrl-0 = <&adc_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&pinctrl {
	gpioa_default: gpioa_default {
		group1 {
			psels = <BEE_PSEL_GPIOA_30_P4_3>; //P4_3 GPIO(TEST OUT)
		};

		group2 {
			psels = <BEE_PSEL_GPIOA_4_P0_4>, //P0_4 GPIO(TEST LPQDECX)
				<BEE_PSEL_GPIOA_5_P0_5>; //P0_5 GPIO(TEST LPQDECX)
		};
	};

	gpiob_default: gpiob_default {
		group1 {
			psels = <BEE_PSEL_GPIOB_6_P6_4>; //P6_4 GPIO(TEST IN)
		};
	};

	uart2_default: uart2_default {
		group1 {
			psels = <BEE_PSEL(UART2_TX, P3_2)>;
			output-enable;
			output-high;
			bias-pull-up;
		};

		group2 {
			psels = <BEE_PSEL(UART2_RX, P3_3)>;
			output-disable;
			bias-pull-up;
		};
	};

	uart2_sleep: uart2_sleep {
		group1 {
			psels = <BEE_PSEL(SW_MODE, P3_2)>;
			sleep-hardware-state;
			output-enable;
			output-high;
			bias-pull-up;
		};

		group2 {
			psels = <BEE_PSEL(SW_MODE, P3_3)>;
			sleep-hardware-state;
			output-disable;
			bias-pull-up;
			wakeup-low;
		};
	};

	uart0_default: uart0_default {
		group1 {
			psels = <BEE_PSEL(UART0_TX, P5_1)>;
			output-enable;
			output-high;
			bias-pull-up;
		};

		group2 {
			psels = <BEE_PSEL(UART0_RX, P5_2)>;
			output-disable;
			bias-pull-up;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <BEE_PSEL(SW_MODE, P5_1)>;
			sleep-hardware-state;
			output-enable;
			output-high;
			bias-pull-up;
		};

		group2 {
			psels = <BEE_PSEL(SW_MODE, P5_2)>;
			sleep-hardware-state;
			output-disable;
			bias-pull-up;
			wakeup-low;
		};
	};

	spi0_default: spi0_default {
		group1 {
			psels = <BEE_PSEL(SPI0_CLK_MASTER, P6_0)>,
				<BEE_PSEL(SPI0_MO_MASTER, P6_1)>,
				<BEE_PSEL(SPI0_MI_MASTER, P6_2)>,
				<BEE_PSEL(SPI0_SS_N_0_MASTER, P6_3)>;
			output-enable;
			output-high;
			bias-pull-up;
		};
	};

	spi0_sleep: spi0_sleep {
		group1 {
			psels = <BEE_PSEL(SW_MODE, P6_0)>,
				<BEE_PSEL(SW_MODE, P6_1)>,
				<BEE_PSEL(SW_MODE, P6_2)>,
				<BEE_PSEL(SW_MODE, P6_3)>;
			sleep-hardware-state;
			output-disable;
			bias-pull-up;
		};
	};

	pwm9_default: pwm9_default {
		group1 {
			psels = <BEE_PSEL(PWM9_P, P0_2)>;
			output-enable;
			output-low;
			bias-pull-down;
		};
	};

	qdec_default: qdec_default {
		group1 {
			psels = <BEE_PSEL(LPQDEC_PHA, P3_4)>,
				<BEE_PSEL(LPQDEC_PHB, P3_5)>;
			output-disable;
			bias-pull-up;
		};
	};

	i2c0_default: i2c0_default {
		group1 {
			psels = <BEE_PSEL(I2C0_CLK, P2_3)>,
				<BEE_PSEL(I2C0_DAT, P2_4)>;
			output-enable;
			output-high;
			bias-pull-up;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <BEE_PSEL(SW_MODE, P2_3)>,
				<BEE_PSEL(SW_MODE, P2_4)>;
			sleep-hardware-state;
			output-enable;
			output-high;
			bias-pull-up;
		};
	};

	keyscan_default: keyscan_default {
		group1 {
			psels = <BEE_PSEL(KEY_COL_0, P2_0)>,
				<BEE_PSEL(KEY_COL_1, P3_6)>;
			output-enable;
			output-low;
			bias-disable;
		};

		group2 {
			psels = <BEE_PSEL(KEY_ROW_0, P0_6)>,
				<BEE_PSEL(KEY_ROW_1, P0_7)>;
			output-disable;
			bias-pull-up;
			bias-pull-strong;
		};
	};

	adc_default: adc_default {
		group1 {
			psels = <BEE_PSEL(SW_MODE, P2_2)>;
			output-disable;
			bias-pull-down;
		};
	};

	can_default: can_default {
		group1 {
			psels = <BEE_PSEL(CAN_TX, P7_0)>,
				<BEE_PSEL(CAN_RX, P7_1)>;
			output-enable;
			output-high;
			bias-disable;
		};
	};

	can_sleep: can_sleep {
		group1 {
			psels = <BEE_PSEL(SW_MODE, P7_0)>;
			sleep-hardware-state;
			output-enable;
			output-high;
			bias-pull-up;
		};

		group2 {
			psels = <BEE_PSEL(SW_MODE, P7_1)>;
			sleep-hardware-state;
			output-disable;
			bias-pull-up;
			wakeup-low;
		};
	};
};
