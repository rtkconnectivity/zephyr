&gpioa {
	status = "okay";
	pinctrl-0 = <&gpioa_default>;
	pinctrl-names = "default";
	ngpios = <32>;
	status = "okay";
};

&dma0 {
	status = "okay";
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
	dmas = <&dma0 2 4 0x10021>, <&dma0 3 5 0xa>;
	dma-names = "tx", "rx";

	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <500000>;
	};

	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

&pinctrl {
	spi0_default: spi0_default {
		group1 {
			psels = <BEE_PSEL(SPI0_CLK_MASTER, P6_0)>,
				<BEE_PSEL(SPI0_MO_MASTER, P6_1)>,
				<BEE_PSEL(SPI0_MI_MASTER, P6_2)>,
				<BEE_PSEL(SPI0_SS_N_0_MASTER, P6_3)>;
			output-enable;
			output-high;
			bias-pull-up;
		};
	};

	gpioa_default: gpioa_default {
		group1 {
			psels = <BEE_PSEL_GPIOA_25_P3_5>;
		};
	};
};
