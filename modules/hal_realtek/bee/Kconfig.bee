	bool "Realtek Bee GRTC HAL"

config HAL_REALTEK_BEE_I2C
	bool "Realtek Bee I2C HAL"

config HAL_REALTEK_BEE_I2S
	bool "Realtek Bee I2S HAL"

config HAL_REALTEK_BEE_IR
	bool "Realtek Bee IR HAL"

config HAL_REALTEK_BEE_KEYSCAN
	bool "Realtek Bee KeyScan HAL"

