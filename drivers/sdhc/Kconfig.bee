config SDHC_BEE
	bool "SDHC driver for Realtek Bee series SoC"
	default y
	depends on DT_HAS_REALTEK_BEE_SDHC_ENABLED
	select USE_HAL_REALTEK_SDHC
	select SDHC_SUPPORTS_NATIVE_MODE

	help
	  This option enables the SDHC driver for Realtek Bee SoCs.

if SDHC_BEE
config SDHC_BUFFER_ALIGNMENT
	default 4
endif
