# RTL87X2G i2s configuration

# Copyright(c) 2025, Realtek Semiconductor Corporation.
# SPDX-License-Identifier: Apache-2.0

menuconfig I2S_RTL87X2G
	bool "RTL87X2G MCU i2s controller driver"
	default y
	depends on DT_HAS_REALTEK_RTL87X2G_I2S_ENABLED
	select DMA
	select USE_HAL_REALTEK_I2S
	help
	  Enable the rtl87x2g i2s driver.

if I2S_RTL87X2G

config I2S_RTL87X2G_RX
	bool "I2S RX"
	default n

if I2S_RTL87X2G_RX

config I2S_RTL87X2G_RX_BLOCK_COUNT
	int "RX queue length"
	default 4

endif # I2S_RTL87X2G_RX

config I2S_RTL87X2G_TX
	bool "I2S TX"
	default n

if I2S_RTL87X2G_TX

config I2S_RTL87X2G_TX_BLOCK_COUNT
	int "TX queue length"
	default 4

endif # I2S_RTL87X2G_TX

endif # I2S_RTL87X2G
