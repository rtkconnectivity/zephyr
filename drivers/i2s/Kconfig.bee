config I2S_BEE
	bool "BEE family I2S driver"
	default y
	depends on DT_HAS_REALTEK_BEE_I2S_ENABLED
	select HAL_REALTEK_BEE_I2S
	select PINCTRL
	select DMA
	help
	  Enable I2S driver for Realtek BEE family SoCs.

if I2S_BEE

config I2S_BEE_TX
	bool "I2S BEE TX support"
	help
	  Enable I2S BEE TX (transmit) support.

config I2S_BEE_RX
	bool "I2S BEE RX support"
	help
	  Enable I2S BEE RX (receive) support.

config I2S_BEE_TX_BLOCK_COUNT
	int "Number of TX blocks / msg queue size"
	default 4
	help
	  Number of TX buffers / message queue size.

config I2S_BEE_RX_BLOCK_COUNT
	int "Number of RX blocks / msg queue size"
	default 4
	help
	  Number of RX buffers / message queue size.

config I2S_BEE_TX_BLOCK_SIZE_MAX
	int "Maximum TX block size (bytes)"
	depends on I2S_BEE_TX
	default 512
	help
	  Upper bound, in bytes, for the TX block size an application may
	  request through i2s_config. The driver reserves two ping-pong DMA
	  buffers of this size per instance; a configuration with a larger
	  block_size is rejected. Raise this if your application uses larger
	  I2S TX blocks.

config I2S_BEE_RX_BLOCK_SIZE_MAX
	int "Maximum RX block size (bytes)"
	depends on I2S_BEE_RX
	default 512
	help
	  Upper bound, in bytes, for the RX block size an application may
	  request through i2s_config. The driver reserves two ping-pong DMA
	  buffers of this size per instance; a configuration with a larger
	  block_size is rejected. Raise this if your application uses larger
	  I2S RX blocks.

endif # I2S_BEE
