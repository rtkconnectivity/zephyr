menuconfig I2S_BEE
	bool "I2S driver for Realtek Bee series SoC"
	default y
	depends on DT_HAS_REALTEK_BEE_I2S_ENABLED
	select DMA
	select USE_HAL_REALTEK_I2S
	help
	  This option enables the I2S driver for Realtek Bee SoCs.

if I2S_BEE

config I2S_BEE_RX
	bool "I2S RX"
	default n

if I2S_BEE_RX

config I2S_BEE_RX_BLOCK_COUNT
	int "RX queue length"
	default 4

endif # I2S_BEE_RX

config I2S_BEE_TX
	bool "I2S TX"
	default n

if I2S_BEE_TX

config I2S_BEE_TX_BLOCK_COUNT
	int "TX queue length"
	default 4

endif # I2S_BEE_TX

endif # I2S_BEE
