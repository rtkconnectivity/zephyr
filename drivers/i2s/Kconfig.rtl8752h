# RTL8752H i2s configuration

# Copyright(c) 2024, Realtek Semiconductor Corporation.
# SPDX-License-Identifier: Apache-2.0

menuconfig I2S_RTL8752H
	bool "RTL8752H MCU i2s controller driver"
	default y
	depends on DT_HAS_REALTEK_RTL8752H_I2S_ENABLED
	select DMA
	select USE_HAL_REALTEK_I2S
	help
	  Enable the RTL8752H i2s driver.

if I2S_RTL8752H

config I2S_RTL8752H_RX
	bool "Enable I2S RX"
	default n

if I2S_RTL8752H_RX

config I2S_RTL8752H_RX_BLOCK_COUNT
	int "RX queue length"
	default 4

endif # I2S_RTL8752H_RX

config I2S_RTL8752H_TX
	bool "Enable I2S TX"
	default n

if I2S_RTL8752H_TX

config I2S_RTL8752H_TX_BLOCK_COUNT
	int "TX queue length"
	default 4

endif # I2S_RTL8752H_TX

endif # I2S_RTL8752H
