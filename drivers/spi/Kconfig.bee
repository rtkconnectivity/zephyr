config SPI_BEE
	bool "SPI driver for Realtek Bee series SoC"
	default y
	depends on DT_HAS_REALTEK_BEE_SPI_ENABLED
	select USE_HAL_REALTEK_SPI
	help
	  This option enables the SPI driver for Realtek Bee SoCs.

if SPI_BEE

config SPI_BEE_INTERRUPT
	bool "BEE MCU SPI Interrupt Support"
	default y if SPI_ASYNC
	default y if SPI_BEE_DMA
	help
	  Enable the interrupt driven mode for SPI instances

config SPI_BEE_DMA
	bool "BEE MCU SPI DMA Support"
	select DMA
	select SPI_BEE_INTERRUPT
	select USE_HAL_REALTEK_DMA
	help
	  Use the DMA for SPI transfer
	  that enable dma channels in their device tree node.

endif # SPI_BEE
