config COUNTER_TIMER_BEE
	bool "BEE timer counter driver"
	default y
	depends on DT_HAS_REALTEK_BEE_TIMER_ENABLED
	select USE_HAL_REALTEK_TIM
	select USE_HAL_REALTEK_ENHTIM
	help
	  Enable the bee counter timer driver.
