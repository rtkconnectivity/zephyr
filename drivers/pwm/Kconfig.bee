config PWM_BEE
	bool "BEE PWM driver"
	default y
	depends on DT_HAS_REALTEK_BEE_PWM_ENABLED
	select USE_HAL_REALTEK_TIM
	select USE_HAL_REALTEK_ENHTIM
	help
	  Enable the bee pwm driver.
