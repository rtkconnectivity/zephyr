menuconfig GPIO_BEE
	bool "GPIO driver for Realtek Bee series SoC"
	default y
	select USE_HAL_REALTEK_GPIO
	depends on DT_HAS_REALTEK_BEE_GPIO_ENABLED
	help
	  This option enables the GPIO driver for Realtek Bee SoCs.

if GPIO_BEE
config BEE_GPIO_SUPPORT_BOTH_EDGE
	bool "Bee GPIO support both edge"
	default y if SOC_SERIES_RTL8752H
endif # GPIO_BEE

if GPIO_BEE && (SOC_RTL8762GTU || SOC_RTL8762GTH)
config BEE_USE_P6_2_AS_GPIOB21
	bool "Use P6_2 as GPIOB_21 on RTL8762GTU or RTL8762GTH"
	default n
	help
	  If true, use P6_2 as GPIOB_21 on RTL8762GTU or RTL8762GTH, else use P9_0.

config BEE_USE_P6_3_AS_GPIOB22
	bool "Use P6_3 as GPIOB_22 on RTL8762GTU or RTL8762GTH"
	default n
	help
	  If true, use P6_3 as GPIOB_22 on RTL8762GTU or RTL8762GTH, else use P9_1.

config BEE_USE_P6_5_AS_GPIOB24
	bool "Use P6_5 as GPIOB_24 on RTL8762GTU or RTL8762GTH"
	default n
	help
	  If true, use P6_5 as GPIOB_24 on RTL8762GTU or RTL8762GTH, else use P9_3.

config BEE_USE_P6_7_AS_GPIOB26
	bool "Use P6_7 as GPIOB_26 on RTL8762GTU or RTL8762GTH"
	default n
	help
	  If true, use P6_7 as GPIOB_26 on RTL8762GTU or RTL8762GTH, else use P9_5.

endif # GPIO_BEE && (SOC_RTL8762GTU || SOC_RTL8762GTH)

if GPIO_BEE && SOC_SERIES_RTL8752H

config BEE_USE_P4_1_AS_GPIO29
	bool "Use P4_1 as GPIO29 on RTL8752H"
	default n
	help
	  If true, use P4_1 as GPIO29 on RTL8752H, else use P3_5.

config BEE_USE_P4_2_AS_GPIO30
	bool "Use P4_2 as GPIO30 on RTL8752H"
	default n
	help
	  If true, use P4_2 as GPIO30 on RTL8752H, else use P3_6.

endif # GPIO_BEE && SOC_SERIES_RTL8752H
