config PINCTRL_BEE
	bool "Pin controller driver for Realtek Bee series SoC"
	default y
	depends on DT_HAS_REALTEK_BEE_PINCTRL_ENABLED
	select USE_HAL_REALTEK_PINMUX
	help
	  This option enables the pin controller driver for Realtek Bee SoCs.
