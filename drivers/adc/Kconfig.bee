config ADC_BEE
	bool "ADC controller driver for Realtek Bee series SoC"
	default y
	depends on DT_HAS_REALTEK_BEE_ADC_ENABLED
	select USE_HAL_REALTEK_ADC
	help
	  This option enables the ADC driver for Realtek Bee SoCs.
