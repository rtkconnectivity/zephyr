config SOC_FLASH_BEE_EFLASH
	bool "Realtek Bee eflash driver"
	default y
	depends on DT_HAS_REALTEK_BEE_EFLASH_CONTROLLER_ENABLED
	select FLASH_HAS_DRIVER_ENABLED
	select FLASH_HAS_PAGE_LAYOUT
	select FLASH_HAS_EXPLICIT_ERASE
	help
	  Enable Realtek Bee eflash driver.
