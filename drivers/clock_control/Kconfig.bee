config CLOCK_CONTROL_BEE
	bool "Bee clock control"
	default y
	depends on DT_HAS_REALTEK_BEE_CCTL_ENABLED
	select USE_HAL_REALTEK_RCC
	help
	  Enable driver for Bee Reset Clock Unit (RCU).
