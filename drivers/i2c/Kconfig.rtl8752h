# RTL8752H i2c configuration

# Copyright(c) 2024, Realtek Semiconductor Corporation.
# SPDX-License-Identifier: Apache-2.0

config I2C_RTL8752H
	bool "RTL8752H I2C driver"
	default y
	depends on DT_HAS_REALTEK_RTL8752H_I2C_ENABLED
	select USE_HAL_REALTEK_I2C
	help
	  Enable the RTL8752H i2c driver.

config I2C_RTL8752H_BUS_RECOVERY
	bool "RTL8752H I2C bus recovery support"
	depends on I2C_RTL8752H
	select I2C_BITBANG
	help
	  Enable I2C bus recovery on RTL8752H by bit-banging the SCL/SDA lines
	  through GPIO. Requires GPIO to be enabled and the scl-gpios and
	  sda-gpios properties on the I2C node.
