config UART_BEE
	bool "Realtek Bee series UART driver"
	default y
	depends on DT_HAS_REALTEK_BEE_UART_ENABLED
	select HAL_REALTEK_BEE_UART
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	select PINCTRL
	select SERIAL_SUPPORT_ASYNC \
		if DT_HAS_REALTEK_BEE_DMA_ENABLED
	select DMA if UART_ASYNC_API
	help
	  This option enables the UART driver for Realtek Bee SoCs.

config UART_BEE_KEEP_ACTIVE_TIMEOUT_MSEC
	int "Milliseconds to keep the UART active after it woke the system up"
	depends on PM_DEVICE
	default 5000
	help
	  Keep a UART powered for this long after its RX pad woke the system
	  up, so that the incoming frame is received instead of dropped. Set
	  to 0 to let the UART suspend again right away.

	  This needs a devicetree node that is a wakeup-source and whose sleep
	  pinctrl state configures a pin for wakeup.

	  Note: This does not mean that the system will sleep immediately
	  after timeout, it depends on other check status.
