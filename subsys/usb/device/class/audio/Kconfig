# USB AUDIO configuration options

# Copyright (c) 2020 Nordic Semiconductor ASA
# SPDX-License-Identifier: Apache-2.0

config USB_DEVICE_AUDIO
	bool "USB Audio Device Class Driver"
	select EXPERIMENTAL
	select USB_COMPOSITE_DEVICE
	help
	  USB Audio Device Class driver.
	  Zephyr USB Audio Class is considered experimental
	  and not full.
	  Device configuration is done via dt overlay.

if USB_DEVICE_AUDIO

config USB_DEVICE_AUDIO_SAMPLE_RATE
	int "USB Audio sample rate (Hz)"
	default 16000
	help
	  Sample rate used to build the USB Audio Class descriptors
	  (tSamFreq and isochronous endpoint wMaxPacketSize). Must match
	  the rate the application drives the audio data path at.

module = USB_AUDIO
module-str = USB Audio
source "subsys/logging/Kconfig.template.log_config"

endif #USB_DEVICE_AUDIO
